# OmniPark — Configurações do leitor de placas
# Copie para .env e preencha com seus valores

# URL do seu sistema no Vercel
OMNIPARK_API_URL=https://SEU-APP.vercel.app/api/plate-read

# Chave secreta (deve ser a mesma que PLATE_API_SECRET no Vercel)
OMNIPARK_API_SECRET=minha-chave-secreta-aqui

# Câmera:
#   0          = webcam integrada do PC
#   1, 2, ...  = outras webcams USB
#   rtsp://admin:senha@192.168.1.100:554/stream  = câmera IP RTSP
#   http://192.168.1.50:8080/video               = celular com IP Webcam (Android)
#   C:\caminho\video.mp4                         = vídeo gravado (para testes)
CAMERA_URL=0

# ID da câmera cadastrada no OmniPark (aba Câmeras)
CAMERA_ID=1

# Modelo YOLO de detecção de placas (o .pt já vem nesta pasta)
YOLO_MODEL=license_plate_detector.pt

# Confiança mínima do YOLO para considerar que achou uma placa (0.0 a 1.0)
CONFIANCA_MIN=0.35

# Confiança mínima do OCR para aceitar a leitura de um frame (0.0 a 1.0)
CONF_OCR_MIN=0.70

# Leituras iguais necessárias para confirmar a placa (evita erro de frame ruim)
VOTOS_MIN=3

# Segundos que a placa precisa ficar FORA da imagem para poder ser enviada de
# novo. Enquanto o carro estiver parado na frente da câmera, NÃO duplica.
COOLDOWN_S=30

# Processa 1 a cada N frames (aumente se o computador for fraco)
PULAR_FRAMES=2

# Exibe janela com o vídeo da câmera (true/false)
MOSTRAR_VIDEO=true
